# Market profile: Serbia (rs). See docs/INSTANCES.md.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
OWNER_EMAIL=owner@example.com
WORKSPACE_ID=majstormile
# true creates the Užice demo on first initialization only. false starts empty.
SEED_DEMO_DATA=false
# Optional: storage bucket for photos, documents and backups (default baunavi-evidence).
# Set it to an existing bucket to share a Supabase project, e.g. paveledger-evidence. Files are kept apart by WORKSPACE_ID.
EVIDENCE_BUCKET=
# Optional: where support messages go (defaults to OWNER_EMAIL), and the address the browser falls back to.
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: needed for the daily auto-close, keep-alive and backup jobs.
CRON_SECRET=
# Optional: contractor notice emails via Resend.
RESEND_API_KEY=
MAIL_FROM=
# Single sign-on (see docs/SSO.md). Buttons: azure (Microsoft), google. SAML needs Supabase Pro.
NEXT_PUBLIC_SSO_PROVIDERS=azure,google
NEXT_PUBLIC_SSO_SAML=false
# Server: providers allowed to link an SSO membership, and the email domains allowed to do so (recommended).
SSO_PROVIDERS=azure,google,sso
SSO_ALLOWED_DOMAINS=
